{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "esnext",
    "types": ["melee/vite/client", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["modules.ts", "render.ts", "src", "vite.config.ts"]
}
