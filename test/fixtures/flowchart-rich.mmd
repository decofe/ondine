flowchart TB
  accTitle: Request routing
  accDescr: Requests either read from the cache or query the database.
  subgraph Client
    A["Browser & client"]
  end
  subgraph Server
    B{Cached?}
    C[(Database)]
    D[Response]
    B -->|yes| D
    B -.->|no| C
    C ==> D
  end
  A --> B
  classDef muted fill:#f2f2f2,stroke:#d4d4d4,color:#171717
  class A,D muted
