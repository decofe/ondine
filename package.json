{
  "scripts": {
    "bench": "pnpm build:wasm && vp test bench --run --no-file-parallelism",
    "build": "pnpm build:wasm && zile",
    "build:wasm": "node scripts/build-wasm.ts",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp check --fix",
    "check:size": "node scripts/size.ts",
    "check:types": "tsc && tsc -p playground && tsc -p site",
    "dev": "pnpm build:wasm && zile dev",
    "postinstall": "zile dev",
    "test": "pnpm build:wasm && vp test",
    "test:screenshots": "pnpm build:wasm && vp test --run --project screenshots --update"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@fontsource/geist-mono": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "binaryen": "catalog:",
    "esbuild": "catalog:",
    "mermaid": "catalog:",
    "pele": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "[!start-pkg]": "",
  "name": "melee",
  "description": "Monochrome Mermaid diagrams, compiled with Rust.",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wevm/melee.git"
  },
  "sideEffects": false,
  "bin": {
    "melee": "./dist/cli/bin.js",
    "melee.src": "./src/cli/bin.ts"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "src": "./src/compiler/index.ts",
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./compiler/wasm": {
      "src": "./src/compiler/wasm.ts",
      "types": "./dist/compiler/wasm.d.ts",
      "default": "./dist/compiler/wasm.js"
    },
    "./compiler/wasm/all": {
      "src": "./src/compiler/all.ts",
      "types": "./dist/compiler/all.d.ts",
      "default": "./dist/compiler/all.js"
    },
    "./vite": {
      "src": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {},
  "peerDependencies": {
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
